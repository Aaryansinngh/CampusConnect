<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.campusconnect.app.ui.auth.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.campusconnect.app.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_signup"
            app:destination="@id/signupFragment" />
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/signupFragment"
        android:name="com.campusconnect.app.ui.auth.SignupFragment"
        android:label="Signup"
        tools:layout="@layout/fragment_signup">
        <action
            android:id="@+id/action_signup_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/signupFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.campusconnect.app.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/exploreClubsFragment"
        android:name="com.campusconnect.app.ui.explore.ExploreClubsFragment"
        android:label="Explore"
        tools:layout="@layout/fragment_explore_clubs" />

    <fragment
        android:id="@+id/clubDetailFragment"
        android:name="com.campusconnect.app.ui.explore.ClubDetailFragment"
        android:label="Club Detail"
        tools:layout="@layout/fragment_club_detail" />

    <fragment
        android:id="@+id/eventsFragment"
        android:name="com.campusconnect.app.ui.events.EventsFragment"
        android:label="Events"
        tools:layout="@layout/fragment_events" />

    <fragment
        android:id="@+id/eventDetailFragment"
        android:name="com.campusconnect.app.ui.events.EventDetailFragment"
        android:label="Event Detail"
        tools:layout="@layout/fragment_event_detail" />

    <fragment
        android:id="@+id/myEventsFragment"
        android:name="com.campusconnect.app.ui.events.MyEventsFragment"
        android:label="My Events"
        tools:layout="@layout/fragment_my_events" />

    <fragment
        android:id="@+id/postDetailFragment"
        android:name="com.campusconnect.app.ui.posts.PostDetailFragment"
        android:label="Post Detail"
        tools:layout="@layout/fragment_post_detail" />

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.campusconnect.app.ui.notifications.NotificationsFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.campusconnect.app.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/savedPostsFragment"
        android:name="com.campusconnect.app.ui.profile.SavedPostsFragment"
        android:label="Saved Posts"
        tools:layout="@layout/fragment_saved_posts" />

    <fragment
        android:id="@+id/adminDashboardFragment"
        android:name="com.campusconnect.app.ui.admin.AdminDashboardFragment"
        android:label="Admin Dashboard"
        tools:layout="@layout/fragment_admin_dashboard" />

    <fragment
        android:id="@+id/createPostFragment"
        android:name="com.campusconnect.app.ui.admin.CreatePostFragment"
        android:label="Create Post"
        tools:layout="@layout/fragment_create_post" />

    <fragment
        android:id="@+id/createEventFragment"
        android:name="com.campusconnect.app.ui.admin.CreateEventFragment"
        android:label="Create Event"
        tools:layout="@layout/fragment_create_event" />

    <fragment
        android:id="@+id/eventRegistrationsFragment"
        android:name="com.campusconnect.app.ui.admin.EventRegistrationsFragment"
        android:label="Event Registrations"
        tools:layout="@layout/fragment_event_registrations" />

    <fragment
        android:id="@+id/superAdminDashboardFragment"
        android:name="com.campusconnect.app.ui.superadmin.SuperAdminDashboardFragment"
        android:label="Super Admin Dashboard"
        tools:layout="@layout/fragment_super_admin_dashboard" />

</navigation>
