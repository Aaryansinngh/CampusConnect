.idea/
*.iml
*.iws
*.ipr
.idea_modules/

# Android Studio Navigation editor temp files
.navigation/

# Android Profiler memory capture files
*.hprof

# OS-specific files
.DS_Store
Thumbs.db

# Android NDK / CMake
.cxx/
.externalNativeBuild/

# Backup and swap files
*~
*.swp
*.bak
